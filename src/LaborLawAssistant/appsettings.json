{
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=laborlaw.db",
    "PostgreSQL": ""
  },
  "Storage": {
    "Provider": "Local",
    "BucketName": ""
  },
  "VoyageAI": {
    "Model": "voyage-4"
  },
  "Search": {
    "TopK": 5,
    "MinScore": 0.4
  },
  "Anthropic": {
    "Model": "claude-opus-5-5",
    "InputPricePerMillionTokens": 4.0,
    "OutputPricePerMillionTokens": 20.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
