@{
    ViewData["Title"] = Localizer["History"];
}

<div class="page-header">
    <h1 class="page-title">@ViewData["Title"]</h1>
</div>

<div class="card empty-state">
    <span class="feature-icon mx-auto"><icon name="clock" size="26" /></span>
    <p class="mb-1 fw-semibold text-body">@Localizer["History is coming soon."]</p>
    <p class="mb-0">@Localizer["Every question you ask is already saved with its answer and cost."]</p>
</div>
