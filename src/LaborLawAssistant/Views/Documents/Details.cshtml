@model DocumentDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">
            @Html.DisplayFor(_ => Model.Country) · @Localizer["{0} pages · {1} articles", Model.PageCount, Model.Articles.TotalCount]
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Back to documents"]</a>
</div>

@if (TempData["EmbeddedCount"] is int embeddedNow)
{
    <div class="alert alert-success">@Localizer["Embeddings created for {0} articles.", embeddedNow]</div>
}
@if (TempData["EmbeddingsFailed"] is true)
{
    <div class="alert alert-danger">@Localizer["The embeddings could not be created. Check the Voyage AI API key and the internet connection, then try again."]</div>
}

@if (Model.EmbeddedCount < Model.Articles.TotalCount)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>@Localizer["{0} of {1} articles have embeddings. Questions can only find articles that have one.", Model.EmbeddedCount, Model.Articles.TotalCount]</span>
        <form asp-action="Embed" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2">
            <span class="small text-body-secondary">@Localizer["This can take a few minutes."]</span>
            <button type="submit" class="btn btn-warning btn-sm">@Localizer["Create embeddings"]</button>
        </form>
    </div>
}

<p class="small text-muted mb-3">
    @Localizer["Showing articles {0}–{1} of {2}", Model.Articles.FirstItemNumber, Model.Articles.LastItemNumber, Model.Articles.TotalCount]
    · @Localizer["Embeddings: {0} / {1}", Model.EmbeddedCount, Model.Articles.TotalCount]
</p>

<div class="row row-cols-1 row-cols-lg-2 g-3 mb-4">
    @foreach (var article in Model.Articles.Items)
    {
        <div class="col">
            <partial name="_ArticleCard" model="new ArticleCardViewModel(article)" />
        </div>
    }
</div>

<partial name="_Pagination" model="Model.Articles.Pagination" />
