@model DocumentDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var ready = Model.EmbeddedCount == Model.Articles.TotalCount;
}

<a asp-action="Index" class="back-link"><icon name="arrow-left" size="16" class="flip-rtl" />@Localizer["Back to documents"]</a>

<div class="page-header">
    <h1 class="page-title">@Model.Title</h1>
    <p class="page-subtitle">@Html.DisplayFor(_ => Model.Country)</p>
</div>

<div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
    <div class="col">
        <div class="card stat h-100">
            <span class="feature-icon"><icon name="file" size="20" /></span>
            <div>
                <div class="stat-value">@Model.PageCount</div>
                <div class="stat-label">@Localizer["Pages"]</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card stat h-100">
            <span class="feature-icon"><icon name="book" size="20" /></span>
            <div>
                <div class="stat-value">@Model.Articles.TotalCount</div>
                <div class="stat-label">@Localizer["Articles"]</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card stat h-100">
            <span class="feature-icon @(ready ? "feature-icon-success" : "feature-icon-warning")"><icon name="@(ready ? "check" : "alert")" size="20" /></span>
            <div>
                <div class="stat-value">@Model.EmbeddedCount <span class="fs-6 fw-normal text-body-secondary">/ @Model.Articles.TotalCount</span></div>
                <div class="stat-label">@Localizer["Articles ready for questions"]</div>
            </div>
        </div>
    </div>
</div>

@if (TempData["EmbeddedCount"] is int embeddedNow)
{
    <div class="notice notice-success mb-3">
        <icon name="check" size="20" />
        <span>@Localizer["{0} articles are now ready for questions.", embeddedNow]</span>
    </div>
}
@if (TempData["EmbeddingsFailed"] is true)
{
    <div class="notice notice-danger mb-3">
        <icon name="alert" size="20" />
        <span>@Localizer["The articles could not be prepared right now. Please try again in a minute."]</span>
    </div>
}

@if (!ready)
{
    <div class="notice notice-warning flex-wrap justify-content-between align-items-center mb-4">
        <span class="d-inline-flex align-items-center gap-2">
            <icon name="alert" size="20" />
            @Localizer["{0} of {1} articles are ready for questions. Questions can only find articles that are ready.", Model.EmbeddedCount, Model.Articles.TotalCount]
        </span>
        <form asp-action="Embed" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2">
            <span class="small">@Localizer["This can take a few minutes."]</span>
            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Prepare the articles"]</button>
        </form>
    </div>
}

<p class="small text-body-secondary mb-3">
    @Localizer["Showing articles {0}–{1} of {2}", Model.Articles.FirstItemNumber, Model.Articles.LastItemNumber, Model.Articles.TotalCount]
</p>

<div class="row row-cols-1 row-cols-lg-2 g-3 mb-4">
    @foreach (var article in Model.Articles.Items)
    {
        <div class="col">
            <partial name="_ArticleCard" model="new ArticleCardViewModel(article)" />
        </div>
    }
</div>

<partial name="_Pagination" model="Model.Articles.Pagination" />
