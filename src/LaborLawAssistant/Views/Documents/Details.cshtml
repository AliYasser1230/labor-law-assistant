@model DocumentDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">
            @Html.DisplayFor(_ => Model.Country) · @Localizer["{0} pages · {1} articles", Model.PageCount, Model.Articles.TotalCount]
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Back to documents"]</a>
</div>

<p class="small text-muted mb-3">
    @Localizer["Showing articles {0}–{1} of {2}", Model.Articles.FirstItemNumber, Model.Articles.LastItemNumber, Model.Articles.TotalCount]
</p>

@* Grid: 1 card per row on phones, 2 per row on large screens (Bootstrap row-cols). *@
<div class="row row-cols-1 row-cols-lg-2 g-3 mb-4">
    @foreach (var article in Model.Articles.Items)
    {
        <div class="col">
            <section class="card h-100 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@Localizer["Article {0}", article.ArticleNumber]</span>
                    <span class="badge bg-body-secondary text-body border">@Localizer["Page {0}", article.PageNumber]</span>
                </div>
                @* The law text is English, so it is always left-to-right, even on the Arabic page. *@
                <div class="card-body" dir="ltr">
                    @if (article.Heading is not null)
                    {
                        <h2 class="h6 card-title">@article.Heading</h2>
                    }
                    <div class="law-text article-text small">@article.Text</div>
                </div>
            </section>
        </div>
    }
</div>

<partial name="_Pagination" model="Model.Articles.Pagination" />
