@model UploadDocumentViewModel
@{
    ViewData["Title"] = Localizer["Upload a law PDF"];
}

<a asp-action="Index" class="back-link"><icon name="arrow-left" size="16" class="flip-rtl" />@Localizer["Back to documents"]</a>

<div class="page-header">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <p class="page-subtitle">@Localizer["Upload the official law PDF. The app reads it, finds every article, and prepares it for questions."]</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="card">
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="Country" class="form-label"></label>
                        <select asp-for="Country" asp-items="Html.GetEnumSelectList<Country>()" class="form-select"></select>
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                    <div class="col-md-7">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="@Localizer["Example: Saudi Labor Law"]" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="File" class="form-label"></label>
                        <div class="dropzone">
                            <span class="feature-icon mx-auto mb-3"><icon name="upload" size="22" /></span>
                            <input asp-for="File" class="form-control" accept=".pdf,application/pdf" />
                            <div class="form-text mt-2">@Localizer["PDF only, up to {0} MB.", UploadDocumentViewModel.MaxFileSizeMb]</div>
                        </div>
                        <span asp-validation-for="File" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2"><icon name="upload" />@Localizer["Upload"]</button>
                    <a asp-action="Index" class="btn btn-link text-decoration-none">@Localizer["Back to documents"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/file-validation.js" asp-append-version="true"></script>
}
