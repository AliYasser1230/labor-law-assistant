@model List<DocumentListItemViewModel>
@{
    ViewData["Title"] = Localizer["Documents"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Upload" class="btn btn-primary">@Localizer["Upload a law PDF"]</a>
</div>

@if (TempData["UploadedTitle"] is string uploadedTitle)
{
    <div class="alert alert-success">@Localizer["\"{0}\" was uploaded: {1} articles found.", uploadedTitle, TempData["ArticleCount"] ?? 0]</div>
}
@if (TempData["EmbeddingsFailed"] is true)
{
    <div class="alert alert-warning">@Localizer["The articles were saved, but the embeddings could not be created. Open the law and click \"Create embeddings\" to try again."]</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">@Localizer["No laws uploaded yet."]</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Country"]</th>
                    <th>@Localizer["File"]</th>
                    <th>@Localizer["Pages"]</th>
                    <th>@Localizer["Articles"]</th>
                    <th>@Localizer["Embeddings"]</th>
                    <th>@Localizer["Uploaded"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@document.Id">@document.Title</a></td>
                        <td>@Html.DisplayFor(_ => document.Country)</td>
                        <td class="text-muted small">@document.FileName</td>
                        <td>@document.PageCount</td>
                        <td>@document.ArticleCount</td>
                        <td class="text-nowrap">
                            @(document.EmbeddedCount == document.ArticleCount ? "✅" : "⚠️")
                            @document.EmbeddedCount / @document.ArticleCount
                        </td>
                        <td>@document.UploadedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
