@using System.Globalization
@{
    // Is the current language Arabic? (set by the language cookie, see LanguageController)
    var isArabic = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";

    // Which controller is showing now? Used to highlight the active menu item.
    var currentController = ViewContext.RouteData.Values["controller"] as string;

    // After switching language, come back to this same page.
    var returnUrl = $"~{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["Labor Law Assistant"]</title>
    <script>
        // Dark mode: pick the theme before the page is drawn, so it never flashes white.
        // Use the user's saved choice; if there is none, follow the computer's light/dark setting.
        // Bootstrap reads data-bs-theme="light" or "dark" on <html> and changes all its colors.
        (function () {
            var saved = localStorage.getItem("theme");
            var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.setAttribute("data-bs-theme", saved || (prefersDark ? "dark" : "light"));
        })();
    </script>
    <script type="importmap"></script>
    @if (isArabic)
    {
        @* Bootstrap's right-to-left version: flips margins, menus, and text alignment. *@
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaborLawAssistant.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        @* bg-body = the page background color of the current theme (white in light mode, dark in dark mode). *@
        <nav class="navbar navbar-expand-sm bg-body border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">⚖️ @Localizer["Labor Law Assistant"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu"
                        aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Ask" ? "active" : "")" asp-controller="Ask" asp-action="Index">@Localizer["Ask"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Documents" ? "active" : "")" asp-controller="Documents" asp-action="Index">@Localizer["Documents"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "History" ? "active" : "")" asp-controller="History" asp-action="Index">@Localizer["History"]</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @* Dark mode button (see wwwroot/js/site.js). It shows 🌙 in light mode and ☀️ in dark mode. *@
                        <button type="button" id="themeToggle" class="btn btn-outline-secondary btn-sm"
                                title="@Localizer["Switch light / dark mode"]" aria-label="@Localizer["Switch light / dark mode"]">
                            <span class="theme-icon-for-light">🌙</span>
                            <span class="theme-icon-for-dark">☀️</span>
                        </button>

                        @* Language switch. The form tag helper adds an anti-forgery token automatically. *@
                        <form asp-controller="Language" asp-action="Set" method="post">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" name="culture" value="@(isArabic ? "en" : "ar")" class="btn btn-outline-secondary btn-sm">
                                @(isArabic ? "English" : "العربية")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 bg-body-tertiary">
        <div class="container text-muted small">
            ⚠️ @Localizer["This is information, not legal advice."]
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
