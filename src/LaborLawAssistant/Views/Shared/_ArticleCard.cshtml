@model ArticleCardViewModel
<section class="card h-100 shadow-sm @(Model.IsCited ? "border-success" : "")"
         id="@(Model.SourceNumber is int number ? $"source-{number}" : null)">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <span class="fw-semibold">
            @if (Model.SourceNumber is int sourceNumber)
            {
                <span class="badge text-bg-secondary me-1">@sourceNumber</span>
            }
            @Localizer["Article {0}", Model.Article.ArticleNumber]
        </span>
        <span class="d-flex flex-wrap justify-content-end gap-1">
            @if (Model.IsCited)
            {
                <span class="badge text-bg-success">@Localizer["Cited in the answer"]</span>
            }
            @if (Model.Score is double score)
            {
                <span class="badge bg-body-secondary text-body border">@Localizer["{0}% match", Math.Round(score * 100)]</span>
            }
            <span class="badge bg-body-secondary text-body border">@Localizer["Page {0}", Model.Article.PageNumber]</span>
        </span>
    </div>
    <div class="card-body" dir="ltr">
        @if (Model.LawTitle is not null)
        {
            <div class="small text-body-secondary mb-1">@Model.LawTitle</div>
        }
        @if (Model.Article.Heading is not null)
        {
            <h2 class="h6 card-title">@Model.Article.Heading</h2>
        }
        <div class="law-text article-text small">@Model.Article.Text</div>
    </div>
</section>
