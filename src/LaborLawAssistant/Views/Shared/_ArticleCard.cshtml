@model ArticleCardViewModel
<section class="card article-card h-100 @(Model.IsCited ? "is-cited" : "")"
         id="@(Model.SourceNumber is int number ? $"source-{number}" : null)">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <span class="d-inline-flex align-items-center gap-2 fw-semibold">
            @if (Model.SourceNumber is int sourceNumber)
            {
                <span class="source-number">@sourceNumber</span>
            }
            @Localizer["Article {0}", Model.Article.ArticleNumber]
        </span>
        <span class="d-flex flex-wrap justify-content-end gap-1">
            @if (Model.IsCited)
            {
                <span class="pill pill-primary"><icon name="check" size="12" />@Localizer["Cited in the answer"]</span>
            }
            <span class="pill">@Localizer["Page {0}", Model.Article.PageNumber]</span>
        </span>
    </div>
    <div class="card-body" dir="ltr">
        @if (Model.LawTitle is not null)
        {
            <div class="small text-body-secondary mb-1">@Model.LawTitle</div>
        }
        @if (Model.Article.Heading is not null)
        {
            <h3 class="article-heading">@Model.Article.Heading</h3>
        }
        <div class="law-text article-text small">@Model.Article.Text</div>
    </div>
</section>
