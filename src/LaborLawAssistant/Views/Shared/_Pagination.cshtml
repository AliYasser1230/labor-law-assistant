@model PaginationViewModel
@{
    var numbers = Enumerable.Range(1, Model.TotalPages)
        .Where(n => n == 1 || n == Model.TotalPages || Math.Abs(n - Model.PageNumber) <= 2)
        .ToList();
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="@Localizer["Pages"]">
        <ul class="pagination justify-content-center flex-wrap">
            @if (Model.PageNumber == 1)
            {
                <li class="page-item disabled"><span class="page-link">@Localizer["Previous"]</span></li>
            }
            else
            {
                <li class="page-item"><a class="page-link" href="@Url.Action(null, new { page = Model.PageNumber - 1 })">@Localizer["Previous"]</a></li>
            }

            @for (var i = 0; i < numbers.Count; i++)
            {
                if (i > 0 && numbers[i] - numbers[i - 1] > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }

                var number = numbers[i];
                if (number == Model.PageNumber)
                {
                    <li class="page-item active" aria-current="page"><span class="page-link">@number</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action(null, new { page = number })">@number</a></li>
                }
            }

            @if (Model.PageNumber == Model.TotalPages)
            {
                <li class="page-item disabled"><span class="page-link">@Localizer["Next"]</span></li>
            }
            else
            {
                <li class="page-item"><a class="page-link" href="@Url.Action(null, new { page = Model.PageNumber + 1 })">@Localizer["Next"]</a></li>
            }
        </ul>
    </nav>
}
