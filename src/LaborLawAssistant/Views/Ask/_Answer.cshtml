@model LawAnswer
<section class="card shadow-sm border-primary-subtle mb-4">
    <div class="card-header fw-semibold">@Localizer["Answer"]</div>
    <div class="card-body">
        <div class="answer-text" dir="auto">@foreach (var part in Model.Parts)
            {<span>@part.Text</span>@foreach (var number in part.SourceNumbers)
                {<a href="#source-@number" class="badge text-bg-secondary text-decoration-none mx-1"
                    title="@Localizer["Source {0}", number]">@number</a>}}</div>

        <p class="small text-body-secondary border-top mt-3 pt-2 mb-0">
            ⚠️ @Localizer["This is information, not legal advice."]
            · @Model.Model · @Localizer["{0} input + {1} output tokens", Model.InputTokens, Model.OutputTokens]
            · $@Model.CostUsd.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)
        </p>
    </div>
</section>
