@model LawAnswer
<section class="card answer-card mb-4">
    <div class="card-header">
        <icon name="sparkles" />@Localizer["Answer"]
    </div>
    <div class="card-body p-3 p-md-4">
        <div class="answer-text" dir="auto">@foreach (var part in Model.Parts)
            {<span>@part.Text</span>@foreach (var number in part.SourceNumbers)
                {<a href="#source-@number" class="cite" title="@Localizer["Source {0}", number]">@number</a>}}</div>

        <div class="answer-meta">
            <span class="d-inline-flex align-items-center gap-1"><icon name="alert" size="14" />@Localizer["This is information, not legal advice."]</span>
        </div>
    </div>
</section>
